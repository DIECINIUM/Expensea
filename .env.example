# Application
APP_NAME="SpendGraph AI API"
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Local authentication (development/test only)
DEV_AUTH_ENABLED=true
DEV_USER_ID=00000000-0000-4000-8000-000000000001
# Set false for an empty development ledger after migrations.
DEMO_SEED_ENABLED=true

# Server-side structured extraction (disabled by default)
AI_PROVIDER=disabled
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=gemma4:e4b
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_ATTEMPTS=2
AI_RETRY_BACKOFF_SECONDS=0.25
AI_MAX_INPUT_CHARS=8000
AI_REVIEW_CONFIDENCE_THRESHOLD=0.85

# Deterministic duplicate reconciliation
RECONCILIATION_CANDIDATE_WINDOW_MINUTES=1440
RECONCILIATION_MAX_CANDIDATES=20
RECONCILIATION_POSSIBLE_DUPLICATE_THRESHOLD=0.70
RECONCILIATION_AUTO_MERGE_THRESHOLD=0.92
RECONCILIATION_AMOUNT_WEIGHT=0.35
RECONCILIATION_TIME_WEIGHT=0.25
RECONCILIATION_MERCHANT_WEIGHT=0.20
RECONCILIATION_DESCRIPTION_WEIGHT=0.20

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_USER=spendgraph
POSTGRES_PASSWORD=spendgraph
POSTGRES_DB=spendgraph
POSTGRES_PORT=5432
# Optional full SQLAlchemy URL override. PostgreSQL parts above are used when omitted.
# DATABASE_URL=postgresql+psycopg://spendgraph:spendgraph@localhost:5432/spendgraph

# Web
WEB_HOST=127.0.0.1
WEB_PORT=5173
VITE_GRAPHQL_URL=/graphql

# Compose publishes development ports on loopback by default.
BIND_HOST=127.0.0.1
