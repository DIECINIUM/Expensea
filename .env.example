# Application
APP_NAME="SpendGraph AI API"
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Local authentication (development/test only)
DEV_AUTH_ENABLED=true
DEV_USER_ID=00000000-0000-4000-8000-000000000001
# Application OIDC login is separate from Gmail connector consent.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECONDS=28800
OAUTH_STATE_SECONDS=600
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/connections/gmail/callback
GMAIL_SYNC_MAX_RESULTS=20
GMAIL_OPERATION_TIMEOUT_SECONDS=120
# Private external env JSON key-id -> Fernet key; never commit actual credentials.
# Local keyring rotation is implemented, managed production KMS is not.
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=
TOKEN_ENCRYPTION_KEYS='{}'
# Set false for an empty development ledger after migrations.
DEMO_SEED_ENABLED=true

# Server-side structured extraction (disabled by default)
AI_PROVIDER=disabled
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=gemma4:e4b
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_ATTEMPTS=2
AI_RETRY_BACKOFF_SECONDS=0.25
AI_MAX_INPUT_CHARS=8000
AI_REVIEW_CONFIDENCE_THRESHOLD=0.85

# PostgreSQL-backed extraction worker and admission limits
JOBS_CONCURRENCY=4
JOBS_MAX_PENDING=1000
JOBS_MAX_PENDING_PER_OWNER=50
JOBS_MAX_ATTEMPTS=3
JOBS_LEASE_SECONDS=180
JOBS_TIMEOUT_SECONDS=120
JOBS_POLL_SECONDS=1
JOBS_BACKOFF_SECONDS=2
JOBS_MAX_BACKOFF_SECONDS=300

# Operational telemetry: metrics disabled without a private bearer token
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Deterministic duplicate reconciliation
RECONCILIATION_CANDIDATE_WINDOW_MINUTES=1440
RECONCILIATION_MAX_CANDIDATES=20
RECONCILIATION_POSSIBLE_DUPLICATE_THRESHOLD=0.70
RECONCILIATION_AUTO_MERGE_THRESHOLD=0.92
RECONCILIATION_AMOUNT_WEIGHT=0.35
RECONCILIATION_TIME_WEIGHT=0.25
RECONCILIATION_MERCHANT_WEIGHT=0.20
RECONCILIATION_DESCRIPTION_WEIGHT=0.20

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_USER=spendgraph
POSTGRES_PASSWORD=spendgraph
POSTGRES_DB=spendgraph
POSTGRES_PORT=5432
# Optional full SQLAlchemy URL override. PostgreSQL parts above are used when omitted.
# DATABASE_URL=postgresql+psycopg://spendgraph:spendgraph@localhost:5432/spendgraph

# Web
WEB_HOST=127.0.0.1
WEB_PORT=5173
VITE_GRAPHQL_URL=/graphql

# Compose publishes development ports on loopback by default.
BIND_HOST=127.0.0.1
