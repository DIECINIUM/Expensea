{
  "title": "SpendGraph operational health",
  "uid": "spendgraph-operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "API requests / second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(spendgraph_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API p95 latency (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(spendgraph_http_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "API 5xx / second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(spendgraph_http_requests_total{status=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "AI p95 latency (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(spendgraph_ai_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "title": "AI outcomes / second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(spendgraph_ai_calls_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Reported AI tokens / second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(spendgraph_ai_tokens_total[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    }
  ]
}
